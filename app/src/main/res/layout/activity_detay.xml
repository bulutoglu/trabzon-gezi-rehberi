<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Mekan Büyük Görseli -->
        <ImageView
            android:id="@+id/imgDetayFoto"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:scaleType="centerCrop"
            android:src="@drawable/trabzonlogo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            tools:ignore="WebViewLayout">

            <!-- Mekan Başlığı -->
            <TextView
                android:id="@+id/tvDetayAd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mekan Adı"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#0D47A1"/>

            <!-- YENİ: İLÇE VE KATEGORİ SATIRI (Yan Yana) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- İlçe Etiketi (Gri ve Küçük) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İlçe: "
                    android:textSize="14sp"
                    android:textColor="#757575"/>

                <!-- İlçe Değeri (Bordo ve Belirgin) -->
                <TextView
                    android:id="@+id/tvDetayIlce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maçka"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#A71930"
                    android:layout_marginEnd="16dp"/>

                <!-- Kategori Etiketi (Gri ve Küçük) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kategori: "
                    android:textSize="14sp"
                    android:textColor="#757575"/>

                <!-- Kategori Değeri (Bordo ve Belirgin) -->
                <TextView
                    android:id="@+id/tvDetayKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarihi Yer"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#A71930"/>
            </LinearLayout>

            <!-- Puanlama (RatingBar) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bu mekanı nasıl buldunuz?"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="20dp"/>

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1.0"
                android:progressTint="#FFB300"
                android:layout_marginTop="4dp"/>

            <!-- Açıklama Başlığı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hakkında"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#0D47A1"
                android:layout_marginTop="24dp"/>

            <!-- Açıklama Metni -->
            <TextView
                android:id="@+id/tvDetayAciklama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buraya mekan hakkında uzun bilgiler gelecek..."
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="#424242"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="8dp"/>

            <!-- WebView Başlığı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konum Bilgisi:"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#0D47A1"
                android:layout_marginTop="24dp"/>

            <!-- İnternet Sayfası -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>