<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="153dp"
        android:layout_height="157dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/resim" />

    <TextView
        android:layout_width="194dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Üye Girişi"
        android:textColor="#1B244D"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGirisEposta"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/kutu_tasarimi"
        android:hint="E-posta Adresiniz"
        android:inputType="textEmailAddress"
        android:paddingLeft="15dp" />

    <EditText
        android:id="@+id/etGirisSifre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/kutu_tasarimi"
        android:hint="Şifreniz"
        android:inputType="textPassword"
        android:paddingLeft="15dp" />

    <CheckBox
        android:id="@+id/cbBeniHatirla"
        android:layout_width="149dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="10dp"
        android:text="Beni Hatırla"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGirisYap"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/kutu_tasarimi"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:text="GİRİŞ YAP"
        android:textColor="#FFFFFF"
        android:textSize="16dp" />

    <TextView
        android:id="@+id/tvKayitOlGit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Üye değil misin? Kayıt Ol"
        android:textColor="@android:color/holo_blue_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>