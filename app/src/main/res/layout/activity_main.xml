<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgAnaGorsel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/anasayfa" />

    <TextView
        android:id="@+id/tvBaslik"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Trabzon'u Keşfet"
        android:textColor="#212121"
        android:textSize="35dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSorgulamaSayfasinaGit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/buton_tasarimi"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:text="Yer Ara / Filtrele"
        android:textSize="18sp"
        android:textStyle="bold" />
    <Button
        android:id="@+id/btnFavorilerim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/buton_tasarimi"
        android:text="Favorilerim"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:backgroundTint="#A71930"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvGezilecekYerler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:paddingHorizontal="10dp" />

</LinearLayout>